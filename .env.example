# Dara local environment
# Copy this file to .env, fill only the services you intend to use, then load it
# into the API process. Never commit .env or expose these values to the browser.

# Backblaze B2 — required for durable production behavior.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_REGION=us-east-005
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_PUBLIC_URL_BASE=

# OpenAI — optional for zero-spend demo replay; required for live generation.
OPENAI_API_KEY=
DARA_OPENAI_IMAGE_MODEL=gpt-image-2
DARA_QA_MODEL=gpt-4.1-mini

# Replicate — optional second-provider image fallback for live generation.
REPLICATE_API_TOKEN=

# Shared server-side token. Use the same value in the API and Next.js processes.
DARA_API_TOKEN=
# Optional dedicated HMAC secret for anonymous actor IDs. If blank, the web server
# derives them with DARA_API_TOKEN. Neither value is sent to the browser.
DARA_ANON_ACTOR_SECRET=
# cloudflare for the current tunnel; Vercel sets VERCEL=1 automatically.
DARA_TRUSTED_PROXY=cloudflare

# API runtime.
DARA_LIVE_GENERATION_ENABLED=false
DARA_RUN_CACHE_SECONDS=3600
DARA_LEDGER_CACHE_SECONDS=3600
DARA_GLOBAL_DAILY_SPEND_CAP_USD=5.000000
DARA_GENERATION_RATE_LIMIT_PER_HOUR=6
DARA_CANCEL_RATE_LIMIT_PER_HOUR=20
DARA_ASSET_APPROVAL_RATE_LIMIT_PER_HOUR=20
DARA_PROJECT_MUTATION_RATE_LIMIT_PER_HOUR=10
DARA_SHARE_RATE_LIMIT_PER_HOUR=20
DARA_POLICY_SIMULATION_RATE_LIMIT_PER_MINUTE=60
DARA_ALLOWED_ORIGINS=http://localhost:3000
DARA_PUBLIC_APP_URL=http://localhost:3000
DARA_TENANT_ID=demo
DARA_VERIFY_RATE_LIMIT_PER_MIN=10
DARA_VERIFY_HASH_RATE_LIMIT_PER_MIN=30
DARA_MAX_UPLOAD_MB=100

# Next.js server runtime. This value is read only by server-side proxy routes.
DARA_API_URL=http://127.0.0.1:8000

# B2 ledger continuity. A failed cold start waits before touching B2 again.
DARA_LEDGER_CACHE_SECONDS=60
DARA_LEDGER_INIT_RETRY_SECONDS=300
DARA_LEDGER_QUERY_RETRY_SECONDS=300
