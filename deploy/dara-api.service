[Unit]
Description=Dara governance and provenance API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dara
Group=dara
WorkingDirectory=/opt/dara/api
EnvironmentFile=/etc/dara-api.env
ExecStart=/opt/dara/venv/bin/uvicorn dara.main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=3
TimeoutStopSec=20
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
