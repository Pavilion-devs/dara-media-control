# Dara — environment
# cp .env.example .env  &&  set -a && source .env && set +a
# Never commit .env. Never expose any of these to the browser.

# ---- Backblaze B2 (required) -------------------------------------------------
# https://secure.backblaze.com/app_keys.htm
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=dara-media-control-2026
# Keep B2 in the same region family as the US-East API deployment. These values must
# match the region of the bucket you actually create.
B2_REGION=us-east-005
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# Optional. Set only for a deliberately public bucket or CDN. Private deployments mint
# short-lived presigned URLs at read time and never persist them.
B2_PUBLIC_URL_BASE=

# ---- OpenAI (primary image, video, speech, and prompt expansion) --------------
OPENAI_API_KEY=
DARA_OPENAI_IMAGE_MODEL=gpt-image-2

# ---- Overflow / fallback providers ------------------------------------------
ANTHROPIC_API_KEY=                   # optional custom QA evaluator, not media generation
REPLICATE_API_TOKEN=                 # optional provider-diverse fallback
ELEVENLABS_API_KEY=                  # optional voice fallback

# ---- Dara ---------------------------------------------------------------------
KILN_API_TOKEN=                      # shared workspace bearer token; server-side only
KILN_TENANT_ID=demo
KILN_DEFAULT_POLICY_ID=pol_standard
KILN_ENV=development                 # development | production

# Demo protection. KILN_DEMO_MODE=true makes replay the default landing state.
KILN_DEMO_MODE=true
KILN_LIVE_GENERATION_ENABLED=true
KILN_DAILY_SPEND_CAP_USD=5.00        # enforced by the policy engine itself
KILN_MAX_UPLOAD_MB=100
KILN_VERIFY_RATE_LIMIT_PER_MIN=10
KILN_PRESIGNED_URL_TTL_S=900
KILN_PARQUET_STAGING_DIR=/tmp/dara-parquet

# ---- Frontend (web/.env.local) ------------------------------------------------
# Only NEXT_PUBLIC_* reaches the browser. KILN_API_TOKEN must NOT be prefixed.
DARA_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
