# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/.venv/
**/__pycache__/
*.py[cod]
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# HyperFrames demo: keep authored source and required fonts, exclude capture debris
# and generated review/render outputs.
/videos/dara-demo/capture/**
!/videos/dara-demo/capture/assets/
/videos/dara-demo/capture/assets/**
!/videos/dara-demo/capture/assets/fonts/
!/videos/dara-demo/capture/assets/fonts/**
/videos/dara-demo/.hyperframes/frame-packets/
/videos/dara-demo/AGENTS.md
/videos/dara-demo/CLAUDE.md
/videos/dara-demo/snapshots/
/videos/dara-demo/renders/
/videos/dara-demo/*.mp4
